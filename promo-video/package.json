{
  "name": "agnidrishti-launch-film",
  "version": "1.0.0",
  "private": true,
  "description": "44-second launch film for AgniDrishti, the Seelampur fire risk atlas. Built with Remotion.",
  "scripts": {
    "prestudio": "node scripts/make-audio.mjs",
    "studio": "remotion studio src/index.ts",
    "prerender": "node scripts/make-audio.mjs",
    "render": "remotion render src/index.ts AgniDrishti out/agnidrishti-launch.mp4 --codec=h264 --crf=16",
    "poster": "remotion still src/index.ts AgniDrishti out/poster.png --frame=600",
    "audio": "node scripts/make-audio.mjs",
    "atlas": "node scripts/extract-atlas.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
